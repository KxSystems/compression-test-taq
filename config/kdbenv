#!/usr/bin/env bash
#
# Configures $QEXEC kdb+ environment variable based on QHOME, OS and architecture
#
# Usage: set QHOME and source this script before starting a q process
# Exit codes:
#   0 - Success
#   10 - Unsupported OS
#   20 - QHOME directory not found

# export QHOME="${QHOME:-$HOME/q}"   # kdb classic
export QHOME="${QHOME:-$HOME/.kx}"   # kdb-x


#### Do not change below ####

if [[ ! -d "$QHOME" ]]; then
  echo "Error: QHOME directory '$QHOME' not found" >&2
  exit 20
fi

if [[ -d "$QHOME/bin" ]]; then
  QSUBDIR=bin  # kdb-x
else
  case "$(uname -s)-$(uname -m)" in
    Darwin-*)    QSUBDIR=m64 ;;
    Linux-x86_64) QSUBDIR=l64 ;;
    Linux-aarch64|Linux-arm64) QSUBDIR=l64arm ;;
    *)
      echo "Error: Unsupported OS/architecture combination" >&2
      echo "Only Linux (x86_64/arm64) and macOS are supported" >&2
      exit 10
      ;;
  esac
fi

export QEXEC="$QHOME/$QSUBDIR/q"

if [[ ! -x "$QEXEC" ]]; then
  echo "Warning: q executable not found at '$QEXEC'" >&2
fi

echo "QEXEC is set to $QEXEC"